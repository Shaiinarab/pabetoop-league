# ─────────────────────────────────────────────────────────────────────────────
# Pabetoop League — runtime configuration
#
# Copy to `.env` (or export these variables) before starting the server.
# Never commit the real `.env`.
#
# Every league name the UI renders comes from the LEAGUE_* block below. Nothing
# is hard-coded, so a fork is re-branded by editing these values and nothing
# else — no Go changes, no template edits.
# ─────────────────────────────────────────────────────────────────────────────

# ── League identity (white-label) ────────────────────────────────────────────
# Latin name: used in docs, backup filenames and logs.
LEAGUE_NAME=Pabetoop League
# Persian display name: page titles, the site header and the login page.
LEAGUE_NAME_FA=لیگ فوتبال نوجوانان
# Sport noun used to derive the footer strapline, e.g. فوتبال / فوتسال / بسکتبال.
LEAGUE_DISCIPLINE_FA=فوتبال
# Optional explicit strapline. Leave empty to derive it from the discipline.
LEAGUE_SUBTITLE_FA=

# ── Server ───────────────────────────────────────────────────────────────────
# Listen address (flag -addr wins over this).
ADDR=:8080
# SQLite database file (flag -db wins over this). Created if missing.
DB_PATH=data/pabetoop-league.db
# Template and static directories, for non-standard layouts.
TEMPLATES_DIR=web/templates
STATIC_DIR=web/static

# ── Admin account ────────────────────────────────────────────────────────────
# Bootstrap credentials. ADMIN_PASSWORD is hashed in memory at startup and is
# only used to create the account; ADMIN_PASSWORD_HASH (bcrypt) wins if set.
# In production set one of them, then rotate the password after first login.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ── Sessions ─────────────────────────────────────────────────────────────────
# Either set an explicit secret, or let the server create data/secret.key (0600)
# on first run. Rotating either invalidates existing sessions.
SESSION_SECRET=
SESSION_SECRET_FILE=data/secret.key
